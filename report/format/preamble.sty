% ==========================================
% THEOREM ENVIRONMENTS
% ==========================================
\usepackage{thmtools}
\usepackage{mdframed}

\theoremstyle{definition}

\declaretheorem[
    shaded={rulecolor=gree, rulewidth=1.5pt, bgcolor=white},
    name=Theorem,
]{theorem}

\declaretheorem[
    shaded={rulecolor=blued, rulewidth=1.5pt, bgcolor=blu},
    name=Definition,
]{definition}

\declaretheorem[
    shaded={rulecolor=jspink, rulewidth=1.3pt, bgcolor=white},
    name=Problem,
]{problem}
\counterwithin*{problem}{section}

\declaretheorem[
    shaded={rulecolor=orange, rulewidth=1.5pt, bgcolor=gray1},
    name=Example,
]{example}

\declaretheorem[
    shaded={rulecolor=gree, rulewidth=1.5pt, bgcolor=white},
    name=Corollary,
]{corollary}

% Custom Solution Environment
\newenvironment{solution}
{
    \renewcommand{\qedsymbol}{} 
    \begin{proof}[\textbf{Solution}]
    \rule[0mm]{\textwidth}{0pt} \\[2mm]
}
{
    \end{proof}
}

% Custom Proof Environment
\newenvironment{Proof}
  {\renewcommand\qedsymbol{$\square$}\begin{proof}[\textbf{Proof}]}
  {\end{proof}}

