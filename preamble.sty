\ProvidesPackage{preamble}

% =============================================================================
%  1. ENCODING AND LANGUAGE
%     English is the main language; Vietnamese is available when needed.
%     For a mostly-Vietnamese report, see README ("Vietnamese text").
% =============================================================================
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[main=english,vietnamese]{babel}
\usepackage{microtype}

% =============================================================================
%  2. PAGE GEOMETRY AND SPACING
% =============================================================================
\usepackage[a4paper, margin=1in]{geometry}
\usepackage{multicol}
\usepackage{enumitem}
\usepackage{lastpage}

\parindent 0ex
\setlength{\parskip}{0.5em}

% =============================================================================
%  3. MATHEMATICS
% =============================================================================
\usepackage{amsmath, amssymb, amsfonts, amsthm}

% =============================================================================
%  4. GRAPHICS, TABLES AND BOXES
% =============================================================================
\usepackage{graphicx}
\graphicspath{{images/}}
\usepackage{pdflscape}
\usepackage{float}
\usepackage{caption}
\usepackage{subcaption}
\usepackage{multirow}
\usepackage{tabularx}
\usepackage{booktabs}
\usepackage{array}
\usepackage{tikz}
\usetikzlibrary{calc}
\usepackage{xcolor}

% Palette and logo path (must load after xcolor, before the theorem boxes)
\input{branding.tex}

\usepackage[most]{tcolorbox}

% =============================================================================
%  5. CODE LISTINGS
% =============================================================================
\usepackage{listings}
\definecolor{codegreen}{rgb}{0,0.6,0}
\definecolor{codegray}{rgb}{0.5,0.5,0.5}
\definecolor{codepurple}{rgb}{0.58,0,0.82}
\definecolor{backcolour}{rgb}{0.95,0.95,0.92}

\lstdefinestyle{mystyle}{
    backgroundcolor=\color{backcolour},
    commentstyle=\color{codegreen},
    keywordstyle=\color{magenta},
    numberstyle=\tiny\color{codegray},
    stringstyle=\color{codepurple},
    basicstyle=\ttfamily\footnotesize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=2
}
\lstset{style=mystyle}

% Inline code, e.g. \codeinline{SELECT * FROM t;}
\newtcbox{\codeinline}{
    on line,
    arc=3pt,
    colback=BrandSoft,
    colframe=BrandSoft,
    boxrule=0pt,
    boxsep=1pt,
    left=2pt,
    right=2pt,
    top=1pt,
    bottom=1pt,
    fontupper=\ttfamily\small
}

% =============================================================================
%  6. THEOREM-LIKE ENVIRONMENTS
%     Ready to use: theorem, definition, problem, example, corollary, solution
% =============================================================================
\newcounter{memberno}   % used by titlepage.tex and contributions.tex

\usepackage{thmtools}
\usepackage{mdframed}

\theoremstyle{definition}

\declaretheorem[
    shaded={rulecolor=TheoremGreen, rulewidth=1.5pt, bgcolor=white},
    name=Theorem,
]{theorem}

\declaretheorem[
    shaded={rulecolor=BrandPrimary, rulewidth=1.5pt, bgcolor=BrandLight},
    name=Definition,
]{definition}

\declaretheorem[
    shaded={rulecolor=BrandAccent, rulewidth=1.3pt, bgcolor=white},
    name=Problem,
]{problem}
\counterwithin*{problem}{section}

\declaretheorem[
    shaded={rulecolor=ExampleOrange, rulewidth=1.5pt, bgcolor=BrandSoft},
    name=Example,
]{example}

\declaretheorem[
    shaded={rulecolor=TheoremGreen, rulewidth=1.5pt, bgcolor=white},
    name=Corollary,
]{corollary}

% Worked solution, e.g. \begin{solution} ... \end{solution}
\newenvironment{solution}
{
    \renewcommand{\qedsymbol}{}
    \begin{proof}[\textbf{Solution}]
}
{
    \end{proof}
}

% =============================================================================
%  7. HEADER AND FOOTER
%     Logo and running title come from branding.tex and metadata.tex.
% =============================================================================
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhead{}
\fancyfoot{}
\setlength{\headheight}{19pt}

\fancyhead[L]{%
    \ifreportlogo
        \IfFileExists{images/\logo}{\includegraphics[height=15pt]{\logo}}{}%
    \fi
}
\fancyhead[R]{\textbf{\reporthead}}
\fancyfoot[C]{\textbf{\thepage{} / \pageref*{LastPage}}}
\renewcommand{\footrulewidth}{0pt}

% =============================================================================
%  8. BIBLIOGRAPHY  (biblatex + biber)
%     Change style=ieee to style=apa (or others) in one place.
% =============================================================================
\usepackage{csquotes}
\usepackage[backend=biber, style=ieee, sorting=none]{biblatex}
\addbibresource{refs.bib}

% =============================================================================
%  9. HYPERLINKS  (always last)
% =============================================================================
\usepackage{hyperref}
\hypersetup{
    colorlinks=true,
    linktoc=all,
    linkcolor=black,
    citecolor=BrandDark,
    urlcolor=BrandPrimary
}
